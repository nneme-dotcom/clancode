<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    articulos.fxml — Pestaña de gestión de artículos.

    Layout:
      VBox
        ├─ Label (título)
        ├─ TitledPane "Nuevo Artículo"
        │    └─ GridPane  (formulario: código, descripción, precio, gastos, tiempo)
        │         └─ HBox (botones Añadir / Limpiar)
        └─ TableView (lista de artículos)

    Controlador: clancode.vista.fx.controllers.ArticulosController
    El controlador recibe el Controlador MVC mediante setControlador()
    después de cargar el FXML (inyección manual desde MainController).
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clancode.vista.fx.controllers.ArticulosController"
      spacing="16"
      style="-fx-background-color: #f4f6f9;">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Título de sección -->
    <Label text="Gestión de Artículos"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- Formulario de alta -->
    <TitledPane text="Nuevo Artículo" expanded="true" collapsible="true">
        <GridPane hgap="12" vgap="10">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <Label text="Código:"               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtCodigo"         GridPane.columnIndex="1" GridPane.rowIndex="0"
                       promptText="Ej: ART001" prefWidth="220"/>

            <Label text="Descripción:"           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtDescripcion"    GridPane.columnIndex="1" GridPane.rowIndex="1"
                       promptText="Nombre del artículo" prefWidth="220"/>

            <Label text="Precio de venta (€):"   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtPrecio"          GridPane.columnIndex="1" GridPane.rowIndex="2"
                       promptText="9.99" prefWidth="220"/>

            <Label text="Gastos de envío (€):"   GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtGastos"          GridPane.columnIndex="1" GridPane.rowIndex="3"
                       promptText="2.50" prefWidth="220"/>

            <Label text="Tiempo preparación (min):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="txtTiempo"             GridPane.columnIndex="1" GridPane.rowIndex="4"
                       promptText="30" prefWidth="220"/>

            <!-- Botones de acción -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  GridPane.columnIndex="1" GridPane.rowIndex="5">
                <Button fx:id="btnAñadir" text="➕ Añadir Artículo"
                        onAction="#onAñadirArticulo"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 8 18;"/>
                <Button fx:id="btnLimpiar" text="🗑 Limpiar"
                        onAction="#onLimpiar"
                        style="-fx-padding: 8 14;"/>
            </HBox>
        </GridPane>
    </TitledPane>

    <!-- Tabla de artículos: columnas definidas con fx:id para acceso desde el controlador -->
    <TableView fx:id="tablaArticulos" prefHeight="280"
               style="-fx-background-color: white;">
        <placeholder><Label text="No hay artículos registrados."/></placeholder>
        <columns>
            <TableColumn fx:id="colCodigo"      text="Código"        prefWidth="100"/>
            <TableColumn fx:id="colDescripcion" text="Descripción"   prefWidth="220"/>
            <TableColumn fx:id="colPrecio"      text="Precio (€)"    prefWidth="100"/>
            <TableColumn fx:id="colGastos"      text="Envío (€)"     prefWidth="100"/>
            <TableColumn fx:id="colTiempo"      text="Prep. (min)"   prefWidth="100"/>
        </columns>
        <VBox.vgrow>ALWAYS</VBox.vgrow>
    </TableView>

</VBox>
